# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS — allow your frontend URL
FRONTEND_URL=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty to use Vite's dev proxy (recommended for local dev)
# Set to full URL in production: https://api.your-domain.com
VITE_API_URL=

# ─── Production overrides ─────────────────────────────────────────────────────
# These are set as GitHub Actions secrets / environment variables in your
# deployment platform — never commit real values to this file.
#
# FRONTEND_URL=https://your-domain.com
# VITE_API_URL=https://api.your-domain.com
